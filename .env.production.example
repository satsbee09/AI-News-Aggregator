# ==========================================================
# Production Environment Configuration Template
# Copy this to .env on your production server: cp .env.production.example .env
# ==========================================================

ENVIRONMENT=production

# ----------------------------------------------------------
# 1. MongoDB Atlas Connection
# Make sure your cluster's Network Access allows your server IP (or 0.0.0.0/0)
# ----------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/news_aggregator?retryWrites=true&w=majority
MONGODB_DB_NAME=news_aggregator

# ----------------------------------------------------------
# 2. LLM Inference (Groq is 100% Free: https://console.groq.com)
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_optional_gemini_key

# ----------------------------------------------------------
# 3. Inter-Service Security Secret
# Generate a random 64-char string: openssl rand -hex 32
# ----------------------------------------------------------
INTERNAL_API_SECRET=c8f5e29a4b7d16038e12f0c9751e3a649b802e5f1d7a3c9e624b80f1e5d7c3a9

# ----------------------------------------------------------
# 4. Email Delivery (Gmail SMTP with 16-char App Password)
# Get App Password at: https://myaccount.google.com/apppasswords
# ----------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RECIPIENT_EMAIL=your_email@gmail.com

# ----------------------------------------------------------
# 5. Live Search APIs (Optional Fallback for breaking queries)
# Google CSE: https://console.cloud.google.com/apis/credentials
# Brave API: https://brave.com/search/api/
# ----------------------------------------------------------
GOOGLE_CSE_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_ID=your_custom_search_engine_id
BRAVE_API_KEY=your_brave_search_api_key

# ----------------------------------------------------------
# 6. Service Networking (Handled automatically by Docker Compose)
# ----------------------------------------------------------
FASTAPI_BASE_URL=http://fastapi-backend:8000
PORT=5000
